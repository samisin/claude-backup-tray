<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      The spec asks for net10.0-windows. We target the 10.0.19041.0 platform flavour
      (a strict superset of net10.0-windows) because CommunityToolkit.WinUI.Notifications
      requires the Windows 10 SDK projection. WinForms still works unchanged.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ClaudeBackupTray</RootNamespace>
    <AssemblyName>ClaudeBackupTray</AssemblyName>
    <Version>1.0.0</Version>
    <Company>Anthropic (community)</Company>
    <Product>Claude Backup Tray</Product>
    <!-- A tray app must never pop a console window. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="scripts\backup.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Tray status icons, embedded into the exe and loaded by TrayIconFactory. -->
    <None Remove="Resources\*.ico" />
    <EmbeddedResource Include="Resources\*.ico" />
  </ItemGroup>

</Project>
